@model IEnumerable<TblEmployee>

@{
    ViewBag.Title = "لیست پرسنل";
}

@section styles {

}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 text-gray-800">@ViewBag.Title</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>افزودن پرسنل جدید
    </a>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive px-3">
            <table id="tblList" class="table display table-striped table-bordered table-hover table-condensed table-responsive">

                <thead>
                    <tr>
                        <th>شماره پرسنلی</th>
                        <th>کد ملی</th>
                        <th>نام</th>
                        <th>نام خانوادگی</th>
                        <th>نام پدر</th>
                        <th>سازمان</th>
                        <th>واحد سازمانی</th>                        
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.EmployeeNumber</td>
                                <td>@item.NationalNumber</td>
                                <td>@item.Name</td>
                                <td>@item.Family</td>
                                <td>@item.Father</td>
                                <td>@(item.Organization?.OrganizationTitle ?? "-")</td>
                                <td>@(item.SecondOrganization?.OrganizationTitle ?? "-")</td>

                                <td>
                                    <a href=@Url.Action("Edit", new {id = item.EmpId}) class="btn btn-sm btn-info text-white"><i class="bi bi-pencil-square"></i></a>
                                    <a href=@Url.Action("Delete", new {id = item.EmpId}) class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
@section scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
}
