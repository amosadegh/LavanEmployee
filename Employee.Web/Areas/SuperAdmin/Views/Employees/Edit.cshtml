@model TblEmployee

@{
    ViewData["Title"] = "ویرایش پرسنل";
}

<h1 class="h3 mb-4 text-gray-800">ویرایش پرسنل</h1>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="EmpId" />

    <!-- Panel 1: هویتی -->
    <div class="card shadow-sm mb-3">
        <div class="card-header" data-bs-toggle="collapse" data-bs-target="#panel1" style="cursor: pointer;">
            <i class="bi bi-chevron-down toggle-icon"></i>
            اطلاعات هویتی
        </div>
        <div id="panel1" class="collapse show">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="EmployeeNumber" class="form-label"></label>
                        <input asp-for="EmployeeNumber" class="form-control" />
                        <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
                    </div>
                <div class="col-md-3">
                        <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Family" class="form-label"></label>
                        <input asp-for="Family" class="form-control" />
                        <span asp-validation-for="Family" class="text-danger"></span>
                    </div>
                <div class="col-md-3">
                        <label asp-for="Father" class="form-label"></label>
                        <input asp-for="Father" class="form-control" />
                        <span asp-validation-for="Father" class="text-danger"></span>
                    </div>
                <div class="col-md-3">
                        <label asp-for="IdentityNumber" class="form-label"></label>
                        <input asp-for="IdentityNumber" class="form-control" />
                        <span asp-validation-for="IdentityNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="NationalNumber" class="form-label"></label>
                        <input asp-for="NationalNumber" class="form-control" />
                        <span asp-validation-for="NationalNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="BirthDate" class="form-label"></label>
                        <input asp-for="BirthDate" class="form-control datepicker" />
                        <span asp-validation-for="BirthDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="BirthProvince" class="form-label"></label>
                <select asp-for="BirthProvince" class="form-select select2" asp-items="ViewBag.Provinces">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="BirthProvince" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="BirthCity" class="form-label"></label>
                        <select asp-for="BirthCity" class="form-select select2">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="BirthCity" class="text-danger"></span>
                    </div>
                <div class="col-md-3">
                        <label asp-for="EntryProvince" class="form-label"></label>
                        <select asp-for="EntryProvince" class="form-select select2" asp-items="ViewBag.Provinces">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="EntryProvince" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                <label asp-for="EntryCity" class="form-label"></label>
                        <select asp-for="EntryCity" class="form-select select2">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="EntryCity" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
