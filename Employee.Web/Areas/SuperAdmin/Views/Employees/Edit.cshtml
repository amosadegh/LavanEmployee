                <option value="">انتخاب کنید</option>
                        </select>
                <span asp-validation-for="OrganizationId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SecondOrganizationId" class="form-label"></label>
                        <select asp-for="SecondOrganizationId" class="form-select select2">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="SecondOrganizationId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                <label asp-for="JobLocId" class="form-label"></label>
                        <select asp-for="JobLocId" class="form-select select2" asp-items="ViewBag.JobLocations">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <span asp-validation-for="JobLocId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="JobTypeId" class="form-label"></label>
                        <select asp-for="JobTypeId" class="form-select select2" asp-items="ViewBag.JobTypes">
                            <option value="">انتخاب کنید</option>
