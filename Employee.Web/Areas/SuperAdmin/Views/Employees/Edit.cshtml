                        </select>
                        <span asp-validation-for="HardShip" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SpecialExtraordinary" class="form-label"></label>
                        <select asp-for="SpecialExtraordinary" class="form-select">
                            <option value="">انتخاب کنید</option>
                            <option value="false">خیر</option>
                            <option value="true">بله</option>
                        </select>
