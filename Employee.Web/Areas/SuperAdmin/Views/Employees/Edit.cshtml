@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/css/persian-datepicker.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/persian-date@1.1.0/dist/persian-date.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/js/persian-datepicker.min.js"></script>

    <script>
        $(document).ready(function () {

            // ── Select2 ────────────────────────
            $('.select2').select2({
                theme: 'bootstrap-5',
                dir: 'rtl',
                language: 'fa',
                placeholder: 'انتخاب کنید',
                allowClear: true
            });

            // ── Persian Datepicker ────────────────────────────
            $('.datepicker').persianDatepicker({
                format: 'YYYY/MM/DD',
                initialValue: false,
                autoClose: true,
                calendar: { persian: { locale: 'fa' } },
                navigator: { enabled: true },
                toolbox: { enabled: true },
                timePicker: { enabled: false }
            });

            // ── توابع Cascade ────────────────────────────────

            // شهرها => خروجی: { id, text }
            function loadCities(provinceId, targetId, selectedId) {
                var $target = $('#' + targetId);
                $target.empty().append('<option value="">انتخاب کنید</option>');
                if (!provinceId) { $target.trigger('change'); return; }

                $.getJSON('@Url.Action("GetCities", "Employees")', { provinceId: provinceId }, function (data) {
                    $.each(data, function (_, item) {
                        $target.append(new Option(item.text, item.id));
                    });
                    if (selectedId) $target.val(selectedId);
                    $target.trigger('change');
                });
            }

            // سازمان دوم => خروجی: { id, title }
            function loadSecondOrgs(organizationId, selectedId) {
                var $target = $('#SecondOrganizationId');
                $target.empty().append('<option value="">انتخاب کنید</option>');
                if (!organizationId) { $target.trigger('change'); return; }

                $.getJSON('@Url.Action("GetSecondOrganizations", "Employees")', { organizationId: organizationId }, function (data) {
                    $.each(data, function (_, item) {
                        $target.append(new Option(item.title, item.id));
                    });
                    if (selectedId) $target.val(selectedId);
                    $target.trigger('change');
                });
            }

            // گرایش تحصیلی => خروجی: { id, title }
            function loadEduOrientations(studyFieldId, selectedId) {
                var $target = $('#EduOrientationId');
                $target.empty().append('<option value="">انتخاب کنید</option>');
                if (!studyFieldId) { $target.trigger('change'); return; }

                $.getJSON('@Url.Action("GetEduOrientations", "Employees")', { studyFieldId: studyFieldId }, function (data) {
                    $.each(data, function (_, item) {
                        $target.append(new Option(item.title, item.id));
                    });
                    if (selectedId) $target.val(selectedId);
                    $target.trigger('change');
                });
            }

            // ── رویدادهای Change ────────────────────────────────
            $('#BirthProvince').on('change', function () {
                loadCities($(this).val(), 'BirthCity', null);
            });

            $('#EntryProvince').on('change', function () {
                loadCities($(this).val(), 'EntryCity', null);
            });

            $('#HomeProvince').on('change', function () {
                loadCities($(this).val(), 'HomeCity', null);
            });

            $('#OrganizationId').on('change', function () {
                loadSecondOrgs($(this).val(), null);
            });

            $('#StudyFieldId').on('change', function () {
                loadEduOrientations($(this).val(), null);
            });

            // ── مقداردهی اولیه حالت Edit ────────────────────────
            var initBirthProvince = '@Model.BirthProvince';
            var initBirthCity = '@Model.BirthCity';
            var initEntryProvince = '@Model.EntryProvince';
            var initEntryCity = '@Model.EntryCity';
            var initHomeProvince = '@Model.HomeProvince';
            var initHomeCity = '@Model.HomeCity';
            var initOrgId = '@Model.OrganizationId';
            var initSecondOrgId = '@Model.SecondOrganizationId';
            var initStudyFieldId = '@Model.StudyFieldId';
            var initEduOrientId = '@Model.EduOrientationId';

            if (initBirthProvince) loadCities(initBirthProvince, 'BirthCity', initBirthCity);
            if (initEntryProvince) loadCities(initEntryProvince, 'EntryCity', initEntryCity);
            if (initHomeProvince) loadCities(initHomeProvince, 'HomeCity', initHomeCity);
            if (initOrgId) loadSecondOrgs(initOrgId, initSecondOrgId);
            if (initStudyFieldId) loadEduOrientations(initStudyFieldId, initEduOrientId);
        });
    </script>
}
