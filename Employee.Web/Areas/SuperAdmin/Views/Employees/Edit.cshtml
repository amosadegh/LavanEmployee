    <!-- Panel 6: شغلی -->
    <div class="card shadow-sm mb-3">
        <div class="card-header" data-bs-toggle="collapse" data-bs-target="#panel6" style="cursor: pointer;">
            <i class="bi bi-chevron-down toggle-icon"></i>
            اطلاعات شغلی
        </div>
        <div id="panel6" class="collapse show">
            <div class="card-body">
