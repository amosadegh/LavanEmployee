                        <span asp-validation-for="HomeProvince" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HomeCity" class="form-label"></label>
                        <select asp-for="HomeCity" class="form-select select2">
                            <option value="">انتخاب کنید</option>
                </select>
                        <span asp-validation-for="HomeCity" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="PostalCode" class="form-label"></label>
                        <input asp-for="PostalCode" class="form-control" />
                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>
