                    </div>
                    <div class="col-md-3">
                        <label asp-for="RemainingAnnualLeave" class="form-label"></label>
                        <input asp-for="RemainingAnnualLeave" class="form-control" type="text" />
                        <span asp-validation-for="RemainingAnnualLeave" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- دکمه‌های عملیات -->
    <!-- فوتر چسبان با دکمه‌های ذخیره و انصراف - نسخه Responsive -->
    <div class="sticky-bottom bg-white border-top shadow-sm p-2 p-md-3 mt-4">
        <div class="d-flex flex-column flex-sm-row justify-content-start gap-2">
            <button type="submit" class="btn btn-success w-100 w-sm-auto">
                <i class="bi bi-check-circle me-2"></i>ذخیره اطلاعات
            </button>
            <a asp-action="Index" class="btn btn-secondary w-100 w-sm-auto">انصراف</a>
        </div>
    </div>

