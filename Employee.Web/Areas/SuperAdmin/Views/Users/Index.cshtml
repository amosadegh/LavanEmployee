@model IEnumerable<Employee.Entities.ViewModels.User.UserViewModel>
@{
    ViewData["Title"] = "مدیریت کاربران";
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">مدیریت کاربران</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> کاربر جدید
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 text-center">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>نام و نام خانوادگی</th>
                    <th>نام کاربری</th>
                    <th>نقش</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int row = 1;
                }
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@(row++)</td>
                        <td>@user.FullName</td>
                        <td>@user.UserName</td>
                        <td>@user.RoleName</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">غیرفعال</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@user.Id"
                               class="btn btn-sm btn-warning">ویرایش</a>

                            <form asp-action="Delete" asp-route-id="@user.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirmDelete(this)">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(form) {
            Swal.fire({
                title: 'حذف کاربر',
                text: 'آیا مطمئن هستید؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف',
                confirmButtonColor: '#d33'
            }).then(result => {
                if (result.isConfirmed) form.submit();
            });
            return false;
        }
    </script>
}
