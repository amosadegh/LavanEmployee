<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>داشبورد | پنل کاربری</title>
    <!-- Bootstrap CSS -->
    @*   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
    rel="stylesheet" /> *@
    <link href="~/assets/lib/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    @*   <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /> *@
    <link href="~/assets/lib/bootstrap/css/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- ** Modern Custom CSS ** -->
    <link rel="stylesheet" href="~/assets/css/style.css" />
    <link href="~/assets/lib/datatables/css/datatables.bootstrap5.min.css" rel="stylesheet" />
    @RenderSection("styles", false)
</head>
<body>
    <div id="main-wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="d-flex flex-column">
            <a asp-controller="Home" asp-action="Index" asp-area="User" class="sidebar-brand d-flex align-items-center">
                <i class="bi bi-hexagon-fill me-2"></i>
                <span class="fw-bold">پنل کاربری</span>
            </a>

            <ul class="nav nav-pills flex-column mb-auto sidebar-nav mt-4">
                <!-- داشبورد -->
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index" asp-area="User" class="nav-link" aria-current="page">
                        <i class="bi bi-grid-1x2-fill me-2"></i>
                        <span>داشبورد</span>
                    </a>
                </li>

                <!-- پروفایل -->
                <li class="nav-item">
                    <a class="nav-link collapsed"
                       data-bs-toggle="collapse"
                       href="#submenuProfile"
                       role="button"
                       aria-expanded="false"
                       aria-controls="submenuProfile">
                        <i class="bi bi-person-circle me-2"></i>
                        <span>پروفایل من</span>
                        <i class="bi bi-chevron-left ms-auto submenu-arrow"></i>
                    </a>
                    <div class="collapse submenu-list-wrapper" id="submenuProfile">
                        <ul class="nav flex-column submenu-list">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="User" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-circle me-2" style="font-size: 0.5rem"></i>
                                    <span>اطلاعات من</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="User" asp-controller="Profile" asp-action="EditPassword">
                                    <i class="bi bi-circle me-2" style="font-size: 0.5rem"></i>
                                    <span>تغییر رمز عبور</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- درخواست‌ها -->
                <li class="nav-item">
                    <a class="nav-link collapsed"
                       data-bs-toggle="collapse"
                       href="#submenuUserRequests"
                       role="button"
                       aria-expanded="false"
                       aria-controls="submenuUserRequests">
                        <i class="bi bi-card-checklist me-2"></i>
                        <span>درخواست‌های من</span>
                        <i class="bi bi-chevron-left ms-auto submenu-arrow"></i>
                    </a>
                    <div class="collapse submenu-list-wrapper" id="submenuUserRequests">
                        <ul class="nav flex-column submenu-list">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="User" asp-controller="Requests" asp-action="Index">
                                    <i class="bi bi-circle me-2" style="font-size: 0.5rem"></i>
                                    <span>لیست درخواست‌ها</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="User" asp-controller="Requests" asp-action="Create">
                                    <i class="bi bi-circle me-2" style="font-size: 0.5rem"></i>
                                    <span>ثبت درخواست جدید</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
                <!-- کارکرد-->
                <li class="nav-item">
                    <a class="nav-link collapsed"
                       data-bs-toggle="collapse"
                       href="#submenuUserWorks"
                       role="button"
                       aria-expanded="false"
                       aria-controls="submenuUserWorks">
                        <i class="bi bi-calendar-date me-2"></i>
                        <span>کارکردهای من</span>
                        <i class="bi bi-chevron-left ms-auto submenu-arrow"></i>
                    </a>
                    <div class="collapse submenu-list-wrapper" id="submenuUserWorks">
                        <ul class="nav flex-column submenu-list">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="User" asp-controller="WorkRecords" asp-action="Index">
                                    <i class="bi bi-circle me-2" style="font-size: 0.5rem"></i>
                                    <span>لیست کارکردها</span>
                                </a>
                            </li>
                          @*   <li class="nav-item">
                                <a class="nav-link" asp-area="User" asp-controller="Requests" asp-action="Create">
                                    <i class="bi bi-circle me-2" style="font-size: 0.5rem"></i>
                                    <span>ثبت کارکرد جدید</span>
                                </a>
                            </li> *@
                        </ul>
                    </div>
                </li>
            </ul>

            <!-- Footer Sidebar -->
            <div class="sidebar-footer mt-auto">
                <div class="dropdown">
                    <a href="#"
                       class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle"
                       id="dropdownUser1"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <img src="/assets/images/avatar.png" alt="User" class="rounded-circle" width="40" height="40" />
                        <div>
                            <strong class="d-block">@User.Identity!.Name</strong>
                            <small class="text-muted">
                                @if (User.IsInRole("User"))
                                {
                                    <span>(کاربر)</span>
                                }
                            </small>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-light text-small shadow" aria-labelledby="dropdownUser1">
                        <li><a class="dropdown-item" href="#">پروفایل</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-action="LogOut" asp-controller="Account" asp-area="">خروج</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main id="main-content">
            <nav id="top-navbar" class="navbar navbar-expand">
                <button class="btn btn-light bg-transparent border-0" id="sidebar-toggle">
                    <i class="bi bi-list"></i>
                </button>
                <div class="ms-auto d-flex align-items-center">
                    <span class="text-muted me-3">امروز: ۱۴۰۵/۰۴/۰۵</span>
                    <div class="dropdown">
                        <a class="nav-link position-relative dropdown-toggle no-arrow"
                           href="#" role="button"
                           id="notificationDropdown"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <i class="bi bi-bell fs-5 text-muted"></i>
                            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                <span class="visually-hidden">اعلان جدید</span>
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end notification-dropdown-menu shadow border-0 py-0"
                            aria-labelledby="notificationDropdown">
                            <li class="dropdown-header d-flex justify-content-between align-items-center py-3 border-bottom">
                                <span class="fw-bold text-dark fs-6">اعلان‌ها</span>
                                <span class="badge bg-primary-soft text-primary">۰ اعلان جدید</span>
                            </li>
                            <li>
                                <a class="dropdown-item text-center py-3 text-primary fw-semibold small" href="#">
                                    مشاهده همه اعلان‌ها
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="container-fluid px-0">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Scripts -->
    @* <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> *@
    <script src="~/assets/js/jquery-3.6.0.min.js"></script>
    @*<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>*@
    <script src="~/assets/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/script.js"></script>
    <script src="~/assets/lib/datatables/js/jquery.datatables.min.js"></script>
    <script src="~/assets/lib/datatables/js/datatables.bootstrap5.min.js"></script>
    @RenderSection("scripts", false)
</body>
</html>
