@model IEnumerable<Employee.Entities.Models.TimeSheet.WorkRecord>
@using Employee.Entities.Models.Enums
@using Employee.Entities.Models.TimeSheet
@using Employee.Web.Helpers
@{
    ViewData["Title"] = "کارکرد من";
    int year = ViewBag.Year;
    int month = ViewBag.Month;
    var sheet = ViewBag.Sheet as MonthlyTimeSheet;
    bool sheetEditable = ViewBag.SheetEditable;
    var totals = (Dictionary<WorkStatusType, int>)ViewBag.DayTotals;
    var st = sheet?.Status ?? MonthlyStatus.Draft;
    var badgeClass = st switch { MonthlyStatus.Draft => "bg-secondary", MonthlyStatus.Submitted => "bg-warning text-dark", MonthlyStatus.ManagerApproved => "bg-info", _ => "bg-success" };
    var badgeText = st switch { MonthlyStatus.Draft => "پیش‌نویس", MonthlyStatus.Submitted => "ارسال‌شده", MonthlyStatus.ManagerApproved => "تأیید مدیر", _ => "تأیید نهایی" };
}

<div class="container-fluid py-3">
    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-clock-history"></i> کارکرد ماهانه
                <span class="badge @badgeClass ms-2">@badgeText</span>
            </span>
            @if (sheetEditable)
            {
                <span>
                    <a asp-action="Create" asp-route-year="@year" asp-route-month="@month" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle"></i> ثبت کارکرد
                    </a>
                    @if (Model.Any())
                    {
                        <form asp-action="Submit" method="post" class="d-inline" onsubmit="return confirm('پس از ارسال، امکان ویرایش نیست. ارسال شود؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="year" value="@year" />
                            <input type="hidden" name="month" value="@month" />
                            <button class="btn btn-success btn-sm"><i class="bi bi-send"></i> ارسال ماه برای تأیید</button>
                        </form>
                    }
                </span>
            }
        </div>
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">سال</label>
                    <select name="year" class="form-select select2" asp-items="ViewBag.Years"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">ماه</label>
                    <select name="month" class="form-select select2" asp-items="ViewBag.Months"></select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-funnel"></i> نمایش</button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success py-2">@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger py-2">@err</div>
    }
    @if (!string.IsNullOrEmpty(sheet?.RejectReason))
    {
        <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle"></i> دلیل برگشت: @sheet.RejectReason</div>
    }

    <div class="row g-3 mb-3">
        @foreach (var kv in totals.Where(k => k.Value > 0))
        {
            <div class="col-6 col-md-3 col-xl">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center py-3">
                        <div class="text-muted small">@TimeSheetHelper.StatusTitle(kv.Key)</div>
                        <div class="fs-3 fw-bold text-primary">@kv.Value</div>
                        <div class="text-muted small">روز</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-header"><i class="bi bi-table"></i> ثبت‌های ماه</div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblList" class="table display table-striped table-bordered table-hover table-condensed table-responsive">
                    <thead>
                        <tr>
                            <th>از تاریخ</th>
                            <th>تا تاریخ</th>
                            <th>وضعیت</th>
                            <th>روز</th>
                            <th>توضیحات</th>
                            @if (sheetEditable)
                            {
                                <th>عملیات</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@TimeSheetHelper.ToPersian(r.FromDate)</td>
                                <td>@TimeSheetHelper.ToPersian(r.ToDate)</td>
                                <td>@TimeSheetHelper.StatusTitle(r.WorkStatus)</td>
                                <td>@r.DayCount</td>
                                <td>@r.Description</td>
                                @if (sheetEditable)
                                {
                                    <td class="text-nowrap">
                                        <a asp-action="Edit" asp-route-id="@r.WorkRecordId" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" asp-route-id="@r.WorkRecordId" method="post" class="d-inline" onsubmit="return confirm('حذف شود؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {

}
