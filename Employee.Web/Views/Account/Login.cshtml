@using Employee.Entities.ViewModels.User
@model LoginViewModel
@{
    ViewData["Title"] = "ورود";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ورود به پنل مدیریت</title>
    <!-- Bootstrap CSS -->    
    <link href="~/assets/lib/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
<div class="auth-wrapper">
    <div class="card shadow-lg auth-card">
        <div class="card-body p-5">
            <h3 class="card-title text-center mb-4">ورود به پنل مدیریت</h3>
            <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="form-horizontal" role="form">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div class="mb-3">
                    <label asp-for="EmployeeNumber" class="form-label">شماره پرسنلی</label>
                    <input asp-for="EmployeeNumber"  class="form-control">
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">رمز عبور</label>
                    <input asp-for="Password" type="password" class="form-control">
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="rememberMe">
                        <label class="form-check-label" for="rememberMe">مرا به خاطر بسپار</label>
                    </div>
                    <a href="forgot-password.html" class="text-decoration-none">فراموشی رمز؟</a>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">ورود</button>
                </div>
            </form>
            <hr>
            <p class="text-center">حساب کاربری ندارید؟ <a href="register.html" class="text-decoration-none">ثبت نام کنید</a></p>
        </div>
    </div>
</div>
    <script src="~/assets/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>




@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
